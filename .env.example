# SMTP credentials used by /api/contact.js to send emails from the contact forms.
# Copy this file to .env.local for local `vercel dev` testing, and add the same
# values under Vercel Project Settings -> Environment Variables for production.
# Never commit the real values.

# Your mail server host, e.g. smtp.gmail.com, smtp.office365.com, or your
# hosting provider's SMTP host for an @tracole.com mailbox.
SMTP_HOST=

# 587 for STARTTLS (most providers), or 465 for implicit TLS.
SMTP_PORT=587

# Full mailbox address used to authenticate and send, e.g. info@tracole.com
SMTP_USER=

# App password / mailbox password for SMTP_USER.
# Gmail/Google Workspace: create an "app password" (requires 2FA enabled) —
# a normal account password will not work.
SMTP_PASS=

# Optional: "From" address shown to recipients. Defaults to SMTP_USER if unset.
SMTP_FROM=

# Optional: where the admin notification email is sent. Defaults to SMTP_USER if unset.
ADMIN_EMAIL=info@tracole.com
